# CampusShare Environment Variables Configuration

# Server Port
PORT=8000

# Database Engine: 'sqlite' or 'mysql'
DATABASE_TYPE=sqlite

# SQLite Path (used when DATABASE_TYPE=sqlite)
SQLITE_DB_PATH=database/campus_share.db

# Cloud MySQL Configuration (used on Render / Production when DATABASE_TYPE=mysql or DATABASE_URL is set)
# DATABASE_URL=mysql://user:password@host:3306/campusshare
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=campusshare

# Allowed CORS Origins (Comma-separated or * for all)
CORS_ORIGIN=*
